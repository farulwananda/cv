---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  mode?: 'cv' | 'home' | 'general';
}

const { mode = 'general' } = Astro.props;
---

<!-- Modern Floating Action Bubble / Side Dock -->
<aside
  id="floating-dock"
  class="fixed right-3 sm:right-5 md:right-6 top-1/2 -translate-y-1/2 z-50 print:hidden animate-dock-side"
  aria-label="Quick Actions"
>
  <div
    class="flex flex-col items-center gap-1 p-1.5 rounded-[8px] bg-[#fbfbf9]/95 dark:bg-[#1a1a1c]/95 backdrop-blur-md border border-[#deddd8] dark:border-[#302f2f] shadow-lg shadow-black/5 dark:shadow-black/60 transition-all duration-200 hover:shadow-xl hover:border-[#c65f36]/40 dark:hover:border-[#df7950]/40"
  >
    {mode === 'cv' ? (
      <button
        id="dock-print-btn"
        type="button"
        onclick="window.print()"
        class="group/print relative inline-flex items-center justify-center p-2 text-[#6f6e69] dark:text-[#a6a49e] hover:text-[#c65f36] dark:hover:text-[#df7950] rounded-[4px] hover:bg-[#efefec] dark:hover:bg-[#161618] transition-colors cursor-pointer"
        title="Print or Save as PDF"
        aria-label="Print or Save as PDF"
      >
        <svg class="w-4 h-4 text-[#6f6e69] dark:text-[#a6a49e] group-hover/print:text-[#c65f36] dark:group-hover/print:text-[#df7950] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
        </svg>
        <span
          class="absolute right-full mr-2.5 top-1/2 -translate-y-1/2 px-2 py-1 text-[11px] font-medium rounded-[4px] bg-[#20201e] dark:bg-[#f1f0ec] text-[#f7f7f5] dark:text-[#111113] shadow-md opacity-0 translate-x-1 group-hover/print:opacity-100 group-hover/print:translate-x-0 transition-all duration-150 pointer-events-none whitespace-nowrap hidden sm:inline-block z-50"
          role="tooltip"
        >
          Print PDF
        </span>
      </button>
    ) : (
      <a
        id="dock-cv-btn"
        href="/cv"
        class="group/cv relative inline-flex items-center justify-center p-2 text-[#6f6e69] dark:text-[#a6a49e] hover:text-[#c65f36] dark:hover:text-[#df7950] rounded-[4px] hover:bg-[#efefec] dark:hover:bg-[#161618] transition-colors cursor-pointer"
        title="View Full Curriculum Vitae"
        aria-label="View Full Curriculum Vitae"
      >
        <svg class="w-4 h-4 text-[#6f6e69] dark:text-[#a6a49e] group-hover/cv:text-[#c65f36] dark:group-hover/cv:text-[#df7950] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <span
          class="absolute right-full mr-2.5 top-1/2 -translate-y-1/2 px-2 py-1 text-[11px] font-medium rounded-[4px] bg-[#20201e] dark:bg-[#f1f0ec] text-[#f7f7f5] dark:text-[#111113] shadow-md opacity-0 translate-x-1 group-hover/cv:opacity-100 group-hover/cv:translate-x-0 transition-all duration-150 pointer-events-none whitespace-nowrap hidden sm:inline-block z-50"
          role="tooltip"
        >
          View CV
        </span>
      </a>
    )}

    <!-- Hairline Divider -->
    <div class="w-4 h-px bg-[#deddd8] dark:bg-[#302f2f] my-0.5" aria-hidden="true"></div>

    <!-- Theme Toggle inside bubble -->
    <ThemeToggle />
  </div>
</aside>
