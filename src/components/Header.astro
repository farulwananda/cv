---
import type { PersonalInfo, SocialLink } from '../types';

interface Props {
  personal: PersonalInfo;
  socialLinks: SocialLink[];
}

const { personal, socialLinks } = Astro.props;
---

<header class="mb-8 print:mb-5 pt-2 sm:pt-4 print:pt-0">
  <!-- Profile Title & Contact -->
  <div class="space-y-3">
    <div class="space-y-0.5">
      <h1 class="text-2xl sm:text-[28px] font-bold tracking-tight text-[#20201e] dark:text-[#f1f0ec] print:text-black">
        {personal.name}
      </h1>
      <p class="text-sm sm:text-base font-normal text-[#6f6e69] dark:text-[#a6a49e] print:text-neutral-700">
        {personal.title}
      </p>
    </div>

    <!-- Contact & Verified Links Bar -->
    <div class="pt-1 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-[#6f6e69] dark:text-[#a6a49e] print:text-neutral-800">
      <!-- Location -->
      <div class="inline-flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-[#6f6e69]/70 dark:text-[#a6a49e]/70 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span>{personal.location}</span>
      </div>

      <!-- Email with Click-to-Copy micro-interaction -->
      <div class="relative inline-flex items-center gap-1 group/email">
        <a
          href={`mailto:${personal.email}`}
          class="inline-flex items-center gap-1.5 hover:text-[#c65f36] dark:hover:text-[#df7950] underline decoration-[#deddd8] dark:decoration-[#302f2f] hover:decoration-[#c65f36] dark:hover:decoration-[#df7950] underline-offset-4 transition-colors"
          title={`Send email to ${personal.email}`}
        >
          <svg class="w-3.5 h-3.5 text-[#6f6e69]/70 dark:text-[#a6a49e]/70 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002-2v-4a2 2 0 002 2h2M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <span>{personal.email}</span>
        </a>

        <!-- Copy Email Button -->
        <button
          id="copy-email-btn"
          type="button"
          data-email={personal.email}
          class="inline-flex items-center justify-center p-1 rounded text-[#6f6e69] hover:text-[#20201e] dark:text-[#a6a49e] dark:hover:text-[#f1f0ec] hover:bg-[#efefec] dark:hover:bg-[#161618] transition-colors print:hidden cursor-pointer relative"
          title="Copy email address"
          aria-label="Copy email address to clipboard"
        >
          <!-- Copy icon -->
          <svg id="copy-email-icon" class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
          </svg>
          <!-- Check icon (hidden initially) -->
          <svg id="check-email-icon" class="w-3.5 h-3.5 text-[#c65f36] dark:text-[#df7950] hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
          </svg>

          <!-- Floating "Copied!" Pill Tooltip -->
          <span
            id="copy-email-tooltip"
            class="absolute -top-7 left-1/2 -translate-x-1/2 px-2 py-0.5 text-[10px] font-sans font-medium tracking-tight bg-[#20201e] dark:bg-[#f1f0ec] text-[#f7f7f5] dark:text-[#111113] rounded shadow-md pointer-events-none opacity-0 translate-y-1 transition-all duration-150 whitespace-nowrap z-30"
            role="status"
          >
            Copied!
          </span>
        </button>
      </div>

      <!-- Social Links (GitHub, LinkedIn) -->
      {socialLinks.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 hover:text-[#c65f36] dark:hover:text-[#df7950] transition-colors group"
        >
          <span>{social.name}</span>
          <svg class="w-2.5 h-2.5 opacity-40 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all print:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  function setupEmailCopy() {
    const copyBtn = document.getElementById('copy-email-btn');
    const copyIcon = document.getElementById('copy-email-icon');
    const checkIcon = document.getElementById('check-email-icon');
    const tooltip = document.getElementById('copy-email-tooltip');

    if (!copyBtn || !copyIcon || !checkIcon || !tooltip) return;

    let timeoutId: number | undefined;

    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email');
      if (!email) return;

      let success = false;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        try {
          await navigator.clipboard.writeText(email);
          success = true;
        } catch (_) {
          // Fallback if clipboard API is restricted
        }
      }

      if (!success) {
        try {
          const textArea = document.createElement('textarea');
          textArea.value = email;
          textArea.style.position = 'fixed';
          textArea.style.opacity = '0';
          document.body.appendChild(textArea);
          textArea.focus();
          if ('execCommand' in document) {
            (document as Record<string, any>)['execCommand']('copy');
          }
          document.body.removeChild(textArea);
          success = true;
        } catch (err) {
          console.error('Failed to copy email:', err);
        }
      }

      // Show user feedback
      copyIcon.classList.add('hidden');
      checkIcon.classList.remove('hidden');
      tooltip.classList.remove('opacity-0', 'translate-y-1');
      tooltip.classList.add('opacity-100', 'translate-y-0');

      if (timeoutId) window.clearTimeout(timeoutId);
      timeoutId = window.setTimeout(() => {
        copyIcon.classList.remove('hidden');
        checkIcon.classList.add('hidden');
        tooltip.classList.add('opacity-0', 'translate-y-1');
        tooltip.classList.remove('opacity-100', 'translate-y-0');
      }, 2000);
    });
  }

  setupEmailCopy();
  document.addEventListener('astro:after-swap', setupEmailCopy);
</script>
