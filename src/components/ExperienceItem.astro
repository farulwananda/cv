---
import type { Experience } from '../types';

interface Props {
  experience: Experience;
}

const { experience } = Astro.props;
---

<article class="space-y-2.5 print-break-inside-avoid">
  <!-- Header: Role, Company, Period & Type -->
  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
    <div>
      <h3 class="text-base font-bold text-[#20201e] dark:text-[#f1f0ec] print:!text-black">
        {experience.role}
      </h3>
      <div class="flex items-center gap-2 text-sm text-[#6f6e69] dark:text-[#a6a49e] pt-0.5">
        <span class="font-medium text-[#20201e] dark:text-[#f1f0ec] print:!text-black">{experience.company}</span>
        <span class="text-[#deddd8] dark:text-[#302f2f]">•</span>
        <span class="text-xs">{experience.location}</span>
      </div>
    </div>

    <div class="flex items-center gap-2 text-xs text-[#6f6e69] dark:text-[#a6a49e] shrink-0">
      <span>{experience.period}</span>
      <span class="hidden sm:inline text-[#deddd8] dark:text-[#302f2f]">•</span>
      <span class="inline-block px-1.5 py-0.5 rounded text-[10px] uppercase font-semibold tracking-wider bg-[#efefec] dark:bg-[#1a1a1c] text-[#6f6e69] dark:text-[#a6a49e] border border-[#deddd8] dark:border-[#302f2f] print:border print:border-neutral-300">
        {experience.type}
      </span>
    </div>
  </div>

  <!-- Summary sentence (clean normal font, consistent with rest of page) -->
  {experience.summary && (
    <p class="text-sm text-[#6f6e69] dark:text-[#d4d2cc] leading-relaxed">
      {experience.summary}
    </p>
  )}

  <!-- Achievements bullet points -->
  <ul class="space-y-1.5 text-sm text-[#6f6e69] dark:text-[#d4d2cc] print:text-neutral-800 list-disc list-outside pl-4 marker:text-[#c65f36] dark:marker:text-[#df7950]">
    {experience.achievements.map((item) => (
      <li class="leading-relaxed">
        {item}
      </li>
    ))}
  </ul>

  <!-- Tech badges -->
  <div class="flex flex-wrap gap-1.5 pt-1">
    {experience.skills.map((skill) => (
      <span class="inline-flex items-center px-2.5 py-0.5 text-xs font-medium rounded-[4px] bg-[#efefec] dark:bg-[#1a1a1c] text-[#20201e] dark:text-[#f1f0ec] border border-[#deddd8] dark:border-[#302f2f] hover:border-[#c65f36] dark:hover:border-[#df7950] transition-colors print:border-neutral-300 badge-tag">
        {skill}
      </span>
    ))}
  </div>
</article>
