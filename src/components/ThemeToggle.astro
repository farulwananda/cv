---
// ThemeToggle.astro
---

<button
  type="button"
  id="theme-toggle"
  data-theme-toggle
  class="group/theme relative inline-flex items-center justify-center p-2 text-[#6f6e69] hover:text-[#20201e] dark:text-[#a6a49e] dark:hover:text-[#f1f0ec] rounded-[4px] hover:bg-[#efefec] dark:hover:bg-[#161618] transition-colors focus:outline-none focus:ring-1 focus:ring-[#deddd8] dark:focus:ring-[#302f2f] cursor-pointer no-print"
  aria-label="Toggle Dark / Light Mode"
  title="Toggle Theme (Dark / Light)"
>
  <!-- Sun icon (shown in dark mode via Tailwind CSS) -->
  <svg
    id="theme-toggle-light-icon"
    class="w-4 h-4 hidden dark:block text-[#f1f0ec]"
    fill="currentColor"
    viewBox="0 0 20 20"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
      fill-rule="evenodd"
      clip-rule="evenodd"
    ></path>
  </svg>

  <!-- Moon icon (shown in light mode via Tailwind CSS) -->
  <svg
    id="theme-toggle-dark-icon"
    class="w-4 h-4 block dark:hidden text-[#20201e]"
    fill="currentColor"
    viewBox="0 0 20 20"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
    ></path>
  </svg>

  <!-- Tooltip on hover (expands to the left) -->
  <span
    class="absolute right-full mr-2.5 top-1/2 -translate-y-1/2 px-2 py-1 text-[11px] font-medium rounded-[4px] bg-[#20201e] dark:bg-[#f1f0ec] text-[#f7f7f5] dark:text-[#111113] shadow-md opacity-0 translate-x-1 group-hover/theme:opacity-100 group-hover/theme:translate-x-0 transition-all duration-150 pointer-events-none whitespace-nowrap hidden sm:inline-block z-50"
    role="tooltip"
  >
    Toggle Theme
  </span>
</button>
