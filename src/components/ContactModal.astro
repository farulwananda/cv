---
interface Props {
  email?: string;
  name?: string;
  availability?: string;
}

const {
  email = "farulwananda@gmail.com",
  name = "Farul Wananda",
  availability = "Open to engineering discussions & collaboration",
} = Astro.props;
---

<!-- Custom Contact & Advisory Modal -->
<div
  id="contact-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 opacity-0 pointer-events-none transition-all duration-200 print:hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="contact-modal-title"
>
  <!-- Backdrop -->
  <div
    id="contact-modal-backdrop"
    class="fixed inset-0 bg-[#111113]/60 dark:bg-black/80 backdrop-blur-[3px] transition-opacity cursor-pointer"
    aria-hidden="true"
  ></div>

  <!-- Modal Dialog Card (Vantis / KodeKarsa Crisp Design) -->
  <div
    id="contact-modal-card"
    class="relative w-full max-w-lg bg-[#fbfbf9] dark:bg-[#1a1a1c] border border-[#deddd8] dark:border-[#302f2f] rounded-[8px] shadow-2xl overflow-hidden transform scale-95 transition-all duration-200 z-10 flex flex-col max-h-[92vh]"
  >
    <!-- Modal Header -->
    <div class="p-5 sm:p-6 pb-4 border-b border-[#deddd8] dark:border-[#302f2f] flex items-start justify-between gap-4">
      <div class="space-y-1.5">
        <!-- Status Pill -->
        <div class="inline-flex items-center px-2 py-0.5 rounded-[4px] bg-[#efefec] dark:bg-[#202022] border border-[#deddd8] dark:border-[#302f2f] text-[11px] font-medium text-[#6f6e69] dark:text-[#a6a49e]">
          <span>{availability}</span>
        </div>

        <h2 id="contact-modal-title" class="text-xl sm:text-2xl font-bold tracking-tight text-[#20201e] dark:text-[#f1f0ec]">
          Initiate Discussion
        </h2>
        <p class="text-xs sm:text-sm text-[#6f6e69] dark:text-[#a6a49e] leading-relaxed">
          Connect directly with {name} for technical advisory, systems architecture, or senior engineering roles.
        </p>
      </div>

      <!-- Close Button -->
      <button
        id="close-contact-modal"
        type="button"
        class="shrink-0 p-1.5 rounded-[4px] text-[#6f6e69] hover:text-[#20201e] dark:text-[#a6a49e] dark:hover:text-[#f1f0ec] hover:bg-[#efefec] dark:hover:bg-[#202022] transition-colors cursor-pointer"
        aria-label="Close dialog"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Modal Body (Scrollable if viewport is small) -->
    <div class="p-5 sm:p-6 overflow-y-auto space-y-5">
      <!-- Quick Dispatch Channels (Direct 1-Click Actions) -->
      <div>
        <label class="block text-xs font-semibold uppercase tracking-wider text-[#6f6e69] dark:text-[#a6a49e] mb-2.5">
          Direct Channels
        </label>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
          <!-- Gmail Webmail -->
          <a
            href={`https://mail.google.com/mail/?view=cm&fs=1&to=${email}&su=Engineering%20Discussion%20-%20Farul%20Wananda`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 p-2.5 rounded-[6px] border border-[#deddd8] dark:border-[#302f2f] bg-[#f7f7f5] dark:bg-[#151516] hover:border-[#c65f36] dark:hover:border-[#df7950] text-[#20201e] dark:text-[#f1f0ec] hover:text-[#c65f36] dark:hover:text-[#df7950] text-xs font-medium transition-colors group"
          >
            <svg class="w-3.5 h-3.5 text-[#c65f36] dark:text-[#df7950] shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24 5.457z"/>
            </svg>
            <span>Open in Gmail</span>
          </a>

          <!-- Outlook Webmail -->
          <a
            href={`https://outlook.live.com/mail/0/deeplink/compose?to=${email}&subject=Engineering%20Discussion%20-%20Farul%20Wananda`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 p-2.5 rounded-[6px] border border-[#deddd8] dark:border-[#302f2f] bg-[#f7f7f5] dark:bg-[#151516] hover:border-[#c65f36] dark:hover:border-[#df7950] text-[#20201e] dark:text-[#f1f0ec] hover:text-[#c65f36] dark:hover:text-[#df7950] text-xs font-medium transition-colors group"
          >
            <svg class="w-3.5 h-3.5 text-[#0078d4] shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22 6.5l-10 6-10-6V5l10 6 10-6v1.5zM2 8.5l10 6 10-6V19a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V8.5z"/>
            </svg>
            <span>Open in Outlook</span>
          </a>

          <!-- LinkedIn Message -->
          <a
            href="https://linkedin.com/in/farulwananda"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 p-2.5 rounded-[6px] border border-[#deddd8] dark:border-[#302f2f] bg-[#f7f7f5] dark:bg-[#151516] hover:border-[#c65f36] dark:hover:border-[#df7950] text-[#20201e] dark:text-[#f1f0ec] hover:text-[#c65f36] dark:hover:text-[#df7950] text-xs font-medium transition-colors group"
          >
            <svg class="w-3.5 h-3.5 text-[#0a66c2] shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            <span>LinkedIn Message</span>
          </a>
        </div>
      </div>

      <!-- Copy Email Address Bar -->
      <div class="p-3 rounded-[6px] bg-[#f7f7f5] dark:bg-[#151516] border border-[#deddd8] dark:border-[#302f2f] flex items-center justify-between gap-3">
        <div class="flex items-center gap-2 min-w-0">
          <svg class="w-4 h-4 text-[#6f6e69] dark:text-[#a6a49e] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002-2v-4a2 2 0 002 2h2M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <span class="text-xs font-mono text-[#20201e] dark:text-[#f1f0ec] truncate select-all">{email}</span>
        </div>
        <button
          id="modal-copy-email-btn"
          type="button"
          data-email={email}
          class="shrink-0 px-2.5 py-1 rounded-[4px] border border-[#deddd8] dark:border-[#302f2f] bg-[#efefec] dark:bg-[#202022] hover:bg-[#deddd8] dark:hover:bg-[#2c2c2f] text-xs font-medium text-[#20201e] dark:text-[#f1f0ec] transition-colors cursor-pointer"
        >
          <span id="modal-copy-text">Copy</span>
        </button>
      </div>

      <!-- Divider -->
      <div class="relative flex items-center justify-center">
        <div class="w-full border-t border-[#deddd8] dark:border-[#302f2f]"></div>
        <span class="absolute bg-[#fbfbf9] dark:bg-[#1a1a1c] px-2 text-[11px] text-[#6f6e69] dark:text-[#a6a49e] uppercase tracking-wider">
          or compose a message
        </span>
      </div>

      <!-- Interactive Inquiry Form -->
      <form id="contact-dialog-form" class="space-y-3.5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label for="sender-name" class="block text-xs font-medium text-[#20201e] dark:text-[#f1f0ec] mb-1">
              Your Name / Organization
            </label>
            <input
              type="text"
              id="sender-name"
              name="name"
              required
              placeholder="e.g. Alex / Acme Corp"
              class="w-full px-3 py-2 text-xs rounded-[4px] border border-[#deddd8] dark:border-[#302f2f] bg-[#f7f7f5] dark:bg-[#151516] text-[#20201e] dark:text-[#f1f0ec] placeholder-[#a6a49e] dark:placeholder-[#6f6e69] focus:outline-none focus:border-[#c65f36] dark:focus:border-[#df7950] transition-colors"
            />
          </div>
          <div>
            <label for="sender-topic" class="block text-xs font-medium text-[#20201e] dark:text-[#f1f0ec] mb-1">
              Inquiry Scope
            </label>
            <select
              id="sender-topic"
              name="topic"
              class="w-full px-3 py-2 text-xs rounded-[4px] border border-[#deddd8] dark:border-[#302f2f] bg-[#f7f7f5] dark:bg-[#151516] text-[#20201e] dark:text-[#f1f0ec] focus:outline-none focus:border-[#c65f36] dark:focus:border-[#df7950] transition-colors"
            >
              <option value="Senior / Lead Fullstack Role">Senior / Lead Fullstack Role</option>
              <option value="Technical Architecture Advisory">Technical Architecture Advisory</option>
              <option value="Consulting / Distributed Systems">Consulting / Distributed Systems</option>
              <option value="General Engineering Discussion">General Engineering Discussion</option>
            </select>
          </div>
        </div>

        <div>
          <label for="sender-message" class="block text-xs font-medium text-[#20201e] dark:text-[#f1f0ec] mb-1">
            Brief Overview
          </label>
          <textarea
            id="sender-message"
            name="message"
            rows="3"
            required
            placeholder="Tell me a bit about the opportunity, system challenges, or what you'd like to collaborate on..."
            class="w-full px-3 py-2 text-xs rounded-[4px] border border-[#deddd8] dark:border-[#302f2f] bg-[#f7f7f5] dark:bg-[#151516] text-[#20201e] dark:text-[#f1f0ec] placeholder-[#a6a49e] dark:placeholder-[#6f6e69] focus:outline-none focus:border-[#c65f36] dark:focus:border-[#df7950] transition-colors resize-none"
          ></textarea>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-1">
          <p class="text-[11px] text-[#6f6e69] dark:text-[#a6a49e] text-center sm:text-left">
            Dispatches directly to {email}
          </p>
          <div class="flex items-center gap-2 w-full sm:w-auto">
            <button
              type="button"
              id="modal-copy-draft-btn"
              class="flex-1 sm:flex-none px-3 py-2 rounded-[4px] border border-[#deddd8] dark:border-[#302f2f] bg-[#efefec] dark:bg-[#202022] hover:bg-[#deddd8] dark:hover:bg-[#2c2c2f] text-xs font-medium text-[#20201e] dark:text-[#f1f0ec] transition-colors cursor-pointer"
            >
              Copy Draft
            </button>
            <button
              type="submit"
              class="flex-1 sm:flex-none inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-[4px] bg-[#c65f36] hover:bg-[#97411f] dark:bg-[#df7950] dark:hover:bg-[#ef956e] text-white dark:text-[#111113] text-xs font-bold shadow-sm transition-all cursor-pointer"
            >
              <span>Send Message</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function setupContactModal() {
    const modalEl = document.getElementById('contact-modal');
    const backdropEl = document.getElementById('contact-modal-backdrop');
    const cardEl = document.getElementById('contact-modal-card');
    const closeBtn = document.getElementById('close-contact-modal');
    const form = document.querySelector<HTMLFormElement>('#contact-dialog-form');
    const copyEmailBtn = document.getElementById('modal-copy-email-btn');
    const copyText = document.getElementById('modal-copy-text');
    const copyDraftBtn = document.getElementById('modal-copy-draft-btn');

    if (!modalEl || !backdropEl || !cardEl) return;

    function openModal() {
      if (!modalEl || !cardEl) return;
      modalEl.classList.remove('opacity-0', 'pointer-events-none');
      modalEl.classList.add('opacity-100', 'pointer-events-auto');
      cardEl.classList.remove('scale-95');
      cardEl.classList.add('scale-100');
      document.body.style.overflow = 'hidden';

      // Auto focus sender name after short animation
      setTimeout(() => {
        const nameInput = document.querySelector<HTMLInputElement>('#sender-name');
        nameInput?.focus();
      }, 100);
    }

    function closeModal() {
      if (!modalEl || !cardEl) return;
      modalEl.classList.remove('opacity-100', 'pointer-events-auto');
      modalEl.classList.add('opacity-0', 'pointer-events-none');
      cardEl.classList.remove('scale-100');
      cardEl.classList.add('scale-95');
      document.body.style.overflow = '';
    }

    // Attach open triggers for any element with data-open-contact-modal
    document.querySelectorAll('[data-open-contact-modal]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    backdropEl.addEventListener('click', closeModal);

    // Keyboard handling (Escape to close)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modalEl.classList.contains('pointer-events-none')) {
        closeModal();
      }
    });

    // Copy Email handler
    copyEmailBtn?.addEventListener('click', async () => {
      const email = copyEmailBtn.getAttribute('data-email');
      if (!email) return;

      try {
        await navigator.clipboard.writeText(email);
        if (copyText) {
          copyText.textContent = 'Copied!';
          setTimeout(() => {
            copyText.textContent = 'Copy';
          }, 2000);
        }
      } catch (err) {
        console.error('Failed to copy email:', err);
      }
    });

    // Copy Draft Handler
    copyDraftBtn?.addEventListener('click', async () => {
      if (!form) return;
      const nameInput = (document.getElementById('sender-name') as any)?.value?.trim() || 'Colleague';
      const topicInput = (document.getElementById('sender-topic') as any)?.value || 'Engineering Inquiry';
      const messageInput = (document.getElementById('sender-message') as any)?.value?.trim();

      const draftText = `Hi Farul,\n\nI am ${nameInput}.\nRegarding: ${topicInput}\n\n${messageInput || 'I would like to discuss engineering opportunities and technical collaboration.'}\n\nBest regards,\n${nameInput}`;

      try {
        await navigator.clipboard.writeText(draftText);
        const originalText = copyDraftBtn.textContent;
        copyDraftBtn.textContent = 'Draft Copied!';
        setTimeout(() => {
          copyDraftBtn.textContent = originalText;
        }, 2000);
      } catch (err) {
        console.error('Failed to copy draft:', err);
      }
    });

    // Form submit: launch user's preferred compose channel
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const nameInput = (document.getElementById('sender-name') as any)?.value?.trim() || 'Colleague';
      const topicInput = (document.getElementById('sender-topic') as any)?.value || 'Engineering Inquiry';
      const messageInput = (document.getElementById('sender-message') as any)?.value?.trim() || '';

      const subject = encodeURIComponent(`[${topicInput}] Message from ${nameInput}`);
      const body = encodeURIComponent(
        `Hi Farul,\n\nMy name is ${nameInput}.\n\nTopic: ${topicInput}\n\nMessage:\n${messageInput}\n\nLooking forward to hearing from you!`
      );

      // Open mail compose smoothly
      window.location.href = `mailto:farulwananda@gmail.com?subject=${subject}&body=${body}`;

      // Show temporary confirmation on button
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) {
        const originalHTML = submitBtn.innerHTML;
        submitBtn.innerHTML = `<span>Opening Mail...</span>`;
        setTimeout(() => {
          submitBtn.innerHTML = originalHTML;
          closeModal();
        }, 1500);
      }
    });
  }

  setupContactModal();
  document.addEventListener('astro:page-load', setupContactModal);
</script>
